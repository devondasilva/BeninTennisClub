# ---- Base de données (fichier SQLite local, aucun serveur à installer) ----
DATABASE_URL="file:btc.db"

# ---- Fuseau horaire du club ----
CLUB_TIMEZONE="Africa/Porto-Novo"

# ---- Authentification ----
JWT_SECRET="change-moi-par-une-longue-chaine-aleatoire"

# ---- URL publique de l'app ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Stripe (optionnel) ----
# Vide = mode démo (paiement simulé). Avec une clé sk_test_..., redirection vers Stripe Checkout.
STRIPE_SECRET_KEY=""

# ---- MTN Mobile Money (optionnel) ----
# Vide = mode démo. Sinon API Collection MoMo (sandbox par défaut).
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENV="sandbox"

# ---- E-mails (optionnel) ----
# Vide = les e-mails sont affichés dans le terminal au lieu d'être envoyés.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Bénin Tennis Club <noreply@benintennis.club>"
