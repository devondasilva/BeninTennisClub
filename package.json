{
  "name": "benin-tennis-club",
  "version": "2.0.0",
  "private": true,
  "description": "Plateforme digitale du Bénin Tennis Club — réservations, événements, boutique, coachs, cordage, collectes",
  "scripts": {
    "predev": "node scripts/check-node.mjs && node scripts/ensure-data.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/check-node.mjs && node scripts/ensure-data.mjs",
    "start": "next start",
    "reset": "node scripts/seed.mjs --force",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:smoke": "node tests/smoke.mjs",
    "images": "node scripts/generate-images.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "next": "14.2.35",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.18"
  }
}
